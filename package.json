{
  "name": "project-release-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "test:e2e": "playwright test",
    "init-admin": "tsx scripts/init-admin.ts",
    "reset-password": "tsx scripts/reset-password.ts",
    "backup": "tsx scripts/backup.ts",
    "test:container": "node scripts/test-container.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@radix-ui/react-dialog": "1.1.23",
    "better-sqlite3": "11.10.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "express-session": "1.19.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "zod": "4.6.7",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "^9.2.1",
    "prettier": "3.9.6",
    "supertest": "^7.1.4",
    "typescript": "5.9.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
