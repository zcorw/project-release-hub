# Copy to .env for Docker Compose and scripts/update-vps.sh (both read it).
# Native npm startup still reads shell environment variables, not this file.
# Keep unused optional settings commented out, rather than assigning empty values.
# The backend host port remains loopback-only, including with an HTTPS proxy.
# PORT controls the app and loopback host port in Compose/updater (1024-65535).
# Docker keeps HUB_BIND_HOST=0.0.0.0 and HUB_DATA_DIR=/app/data fixed.
# HUB_BIND_HOST=127.0.0.1
# 0.0.0.0 is used only inside a loopback-published container.
PORT=4310
HUB_DATA_DIR=./data
# Optional read-only GitHub token. Configure it locally; never commit the value.
# GITHUB_TOKEN=
# Optional MCP bearer token. Use a long random value and keep it private.
# HUB_MCP_TOKEN=

# Optional remote HTTPS/OAuth mode: read docs/account-oauth.md first.
# Initialize privately before enabling. Keep the backend port private.
# HUB_PUBLIC_URL=https://zhixu.example.com
# HUB_SESSION_SECRET=
# HUB_TRUST_PROXY=
# Session secret: at least 48 random characters, configured outside Git.
# Proxy trust: exact controlled peer IPs/CIDRs, never true, hop counts, or /0.
# Remove HUB_MCP_TOKEN when enabling remote OAuth.
# Compose/updater forward PORT and the five optional GitHub/MCP/OAuth settings above.
# Initialize the owner locally before enabling HUB_PUBLIC_URL.
