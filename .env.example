# Load environment variables in your shell before running the server.
# The default server is local-only. Do not bind it publicly.
# HUB_BIND_HOST=127.0.0.1
# The Dockerfile opts into 0.0.0.0 inside a loopback-published container only.
PORT=4310
HUB_DATA_DIR=./data
# Optional read-only GitHub token. Configure it locally; never commit the value.
# GITHUB_TOKEN=
# Optional MCP bearer token. Use a long random value and keep it private.
# HUB_MCP_TOKEN=
