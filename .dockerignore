# Allow only build inputs. Never send local databases, backups, or credentials.
*
!package.json
!package-lock.json
!tsconfig.json
!vite.config.ts
!index.html
!server/
!server/**
!shared/
!shared/**
!web/
!web/**
!assets/
!assets/branding/
!assets/branding/zhixu-plugin-icon.png
!scripts/
!scripts/backup.ts
!scripts/init-admin.ts
!scripts/lib/
!scripts/lib/terminal-password.ts
!scripts/reset-password.ts
# Re-exclude credentials even if someone places them inside a source directory.
**/.env
**/.env.*
**/*.db
**/*.db-wal
**/*.db-shm
**/*.sqlite
**/*.sqlite3
**/*.key
**/*.pem
**/*.pfx
**/*.p12
**/node_modules
